# Snipcart public API key (Test or Live) — get one free at https://app.snipcart.com
# Without this set, the "Add to cart" buttons on /products render but do
# nothing, and the cart button in the nav doesn't appear at all.
NEXT_PUBLIC_SNIPCART_API_KEY=

# Anthropic API key — get one at https://console.anthropic.com
# Powers the shop assistant chat opened by clicking the floating logo.
# Without this set, the assistant tells visitors to call the shop instead.
# Server-only — never prefix with NEXT_PUBLIC_, it's read in app/api/assistant/route.ts.
ANTHROPIC_API_KEY=
